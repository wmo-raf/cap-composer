msgid "Name"
msgstr "ስም"

#: capcomposer/src/capcomposer/capeditor/blocks.py:117
msgid "Name of the recipient"
msgstr "የተቀባዩ ስም"

#: capcomposer/src/capcomposer/capeditor/blocks.py:118
msgid "Address"
msgstr "አድራሻ"

#: capcomposer/src/capcomposer/capeditor/blocks.py:118
