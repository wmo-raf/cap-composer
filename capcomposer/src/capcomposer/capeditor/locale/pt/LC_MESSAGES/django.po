msgstr "Descrição do recurso"

#: capcomposer/src/capcomposer/capeditor/blocks.py:483
#: capcomposer/src/capcomposer/capeditor/blocks.py:492
msgid "The text describing the type and content of the resource file"
msgstr "O texto que descreve o tipo e o conteúdo do arquivo de recursos"

#: capcomposer/src/capcomposer/capeditor/blocks.py:493
msgid "External Resource Link"
msgstr "Link de recurso externo"

#: capcomposer/src/capcomposer/capeditor/blocks.py:494
msgid ""
"Link to external resource. This can be for example a link to related "
"websites. "
msgstr ""
"Link para recurso externo. Pode ser, por exemplo, um link para sites "
"relacionados."

#: capcomposer/src/capcomposer/capeditor/blocks.py:502
msgid "Name for the event code"
msgstr "Nome do código do evento"

#: capcomposer/src/capcomposer/capeditor/blocks.py:503
msgid "Value of the event code"
msgstr "Valor do código do evento"

#: capcomposer/src/capcomposer/capeditor/blocks.py:641
msgid ""
"Alert area polygons must not overlap each other. Intersecting areas are not "
"allowed."
msgstr ""
"Os polígonos da área de alerta não devem se sobrepor. Não são permitidas "
"áreas de interseção."

#: capcomposer/src/capcomposer/capeditor/blocks.py:649
msgid "Immediate - Responsive action SHOULD be taken immediately"
msgstr "Imediato - Acção responsiva DEVE ser tomada imediatamente"

#: capcomposer/src/capcomposer/capeditor/blocks.py:650
msgid "Expected - Responsive action SHOULD be taken soon (within next hour)"
msgstr ""
"Esperado - Acção responsiva DEVE ser tomada em breve (na próxima hora)"

#: capcomposer/src/capcomposer/capeditor/blocks.py:651
msgid "Future - Responsive action SHOULD be taken in the near future"
msgstr "Futuro - Ações responsivas DEVEM ser tomadas em um futuro próximo"

#: capcomposer/src/capcomposer/capeditor/blocks.py:652
msgid "Past - Responsive action is no longer required"
msgstr "Passado - A acção responsiva não é mais necessária"

#: capcomposer/src/capcomposer/capeditor/blocks.py:657
msgid "Extreme - Extraordinary threat to life or property"
msgstr "Extremo - Ameaça extraordinária à vida ou à propriedade"

#: capcomposer/src/capcomposer/capeditor/blocks.py:658
msgid "Severe - Significant threat to life or property"
msgstr "Grave - Ameaça significativa à vida ou propriedade"

#: capcomposer/src/capcomposer/capeditor/blocks.py:659
msgid "Moderate - Possible threat to life or property"
msgstr "Moderado - Possível ameaça à vida ou à propriedade"

#: capcomposer/src/capcomposer/capeditor/blocks.py:660
msgid "Minor - Minimal to no known threat to life or property"
msgstr "Menor - Mínima ou nenhuma ameaça conhecida à vida ou propriedade"

#: capcomposer/src/capcomposer/capeditor/blocks.py:665
msgid "Observed - Determined to have occurred or to be ongoing"
msgstr "Observado - Determinado como tendo ocorrido ou em andamento"

#: capcomposer/src/capcomposer/capeditor/blocks.py:666
msgid "Likely - Likely (percentage > ~50%)"
msgstr "Provável - Provável (porcentagem > ~50%)"

#: capcomposer/src/capcomposer/capeditor/blocks.py:667
msgid "Possible - Possible but not likely (percentage <= ~50%)"
msgstr "Possível - Possível, mas não provável (porcentagem <= ~50%)"

#: capcomposer/src/capcomposer/capeditor/blocks.py:668
msgid "Unlikely - Not expected to occur (percentage ~ 0)"
msgstr "Improvável - Não se espera que ocorra (porcentagem ~ 0)"

#: capcomposer/src/capcomposer/capeditor/blocks.py:672
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:30
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:195
msgid "Event"
msgstr "Evento"

#: capcomposer/src/capcomposer/capeditor/blocks.py:673
msgid ""
"The text denoting the type of the subject event of the alert message. You "
"can define hazards events monitored by your institution from CAP settings"
msgstr ""
"O texto que indica o tipo de evento de assunto da mensagem de alerta. Você "
"pode definir eventos de perigo monitorados pela sua instituição nas "
"configurações do CAP"

#: capcomposer/src/capcomposer/capeditor/blocks.py:676
#: capcomposer/src/capcomposer/capeditor/cap_settings.py:94
msgid "Language"
msgstr "Linguagem"

#: capcomposer/src/capcomposer/capeditor/blocks.py:677
msgid ""
"The code denoting the language of the alert message.If not selected, 'en-US'"
" will be used as default"
msgstr ""
"O código que indica o idioma da mensagem de alerta. Se não for selecionado, "
"'en-US' será usado como padrão"

#: capcomposer/src/capcomposer/capeditor/blocks.py:679
msgid "Urgency"
msgstr "Urgência"

#: capcomposer/src/capcomposer/capeditor/blocks.py:680
msgid ""
"The code denoting the urgency of the subject event of the alert message"
msgstr ""
"O código que denota a urgência do evento em questão da mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:682
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:104
msgid "Severity"
msgstr "Gravidade"

#: capcomposer/src/capcomposer/capeditor/blocks.py:683
msgid ""
"The code denoting the severity of the subject event of the alert message"
msgstr ""
"O código que indica a gravidade do evento em questão da mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:685
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:113
msgid "Certainty"
msgstr "Certeza"

#: capcomposer/src/capcomposer/capeditor/blocks.py:686
msgid ""
"The code denoting the certainty of the subject event of the alert message"
msgstr ""
"O código que denota a certeza do evento em questão da mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:688
msgid "Headline"
msgstr "Título"

#: capcomposer/src/capcomposer/capeditor/blocks.py:689
msgid ""
"The text headline of the alert message. Make it direct and actionable as "
"possible while remaining short"
msgstr ""
"O título do texto da mensagem de alerta. Torne-o o mais direto e acionável "
"possível, mantendo-o curto"

#: capcomposer/src/capcomposer/capeditor/blocks.py:691
msgid "Description"
msgstr "Descrição"

#: capcomposer/src/capcomposer/capeditor/blocks.py:693
msgid ""
"The text describing the subject event of the alert message. An extended "
"description of the hazard or event that occasioned this message"
msgstr ""
"O texto que descreve o evento de assunto da mensagem de alerta. Uma "
"descrição extensa do perigo ou evento que ocasionou esta mensagem"

#: capcomposer/src/capcomposer/capeditor/blocks.py:695
msgid "Instruction"
msgstr "Instrução"

#: capcomposer/src/capcomposer/capeditor/blocks.py:696
msgid ""
"The text describing the recommended action to be taken by recipients of the "
"alert message"
msgstr ""
"O texto que descreve a acção recomendada a ser tomada pelos destinatários da"
" mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:698
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:56
msgid "Effective"
msgstr "Eficaz"

#: capcomposer/src/capcomposer/capeditor/blocks.py:699
msgid ""
"The effective time of the information of the alert message. If not set, the "
"sent date will be used"
msgstr ""
"O tempo efetivo das informações da mensagem de alerta. Se não for definido, "
"a data de envio será usada"

#: capcomposer/src/capcomposer/capeditor/blocks.py:701
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:72
msgid "Onset"
msgstr "Início"

#: capcomposer/src/capcomposer/capeditor/blocks.py:702
msgid ""
"The expected time of the beginning of the subject event of the alert message"
msgstr "A hora esperada do início do evento em questão da mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:704
#: capcomposer/src/capcomposer/capeditor/templates/capeditor/cap_alert_page.html:81
msgid "Expires"
msgstr "Expira"

#: capcomposer/src/capcomposer/capeditor/blocks.py:705
msgid ""
"The expiry time of the information of the alert message. If not set, each "
"recipient is free to set its own policy as to when the message is no longer "
"in effect."
msgstr ""
"O tempo de expiração das informações da mensagem de alerta. Se não for "
"definido, cada destinatário poderá definir sua própria política sobre quando"
" a mensagem não estará mais em vigor."

#: capcomposer/src/capcomposer/capeditor/blocks.py:708
msgid "Response Types"
msgstr "Tipos de resposta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:710
msgid "Sender name"
msgstr "Nome do remetente"

#: capcomposer/src/capcomposer/capeditor/blocks.py:712
#: capcomposer/src/capcomposer/capeditor/cap_settings.py:49
msgid "Contact"
msgstr "Contato"

#: capcomposer/src/capcomposer/capeditor/blocks.py:713
msgid "Audience"
msgstr "Público"

#: capcomposer/src/capcomposer/capeditor/blocks.py:714
msgid "The text describing the intended audience of the alert message"
msgstr "O texto que descreve o público-alvo da mensagem de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:716
msgid "Admin Boundary"
msgstr "Limite de administração"

#: capcomposer/src/capcomposer/capeditor/blocks.py:717
msgid "Draw Polygon"
msgstr "Desenhar polígono"

#: capcomposer/src/capcomposer/capeditor/blocks.py:719
#: capcomposer/src/capcomposer/capeditor/cap_settings.py:208
msgid "Predefined Area"
msgstr "Área predefinida"

#: capcomposer/src/capcomposer/capeditor/blocks.py:720
msgid "Alert Area"
msgstr "Área de Alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:720
msgid "Admin Boundary, Polygon, Circle, or Predefined area"
msgstr "Limite administrativo, polígono, círculo ou área predefinida"

#: capcomposer/src/capcomposer/capeditor/blocks.py:725
msgid "Resources"
msgstr "Recursos"

#: capcomposer/src/capcomposer/capeditor/blocks.py:725
msgid ""
"Additional file with supplemental information related to this alert "
"information"
msgstr ""
"Arquivo adicional com informações suplementares relacionadas a essas "
"informações de alerta"

#: capcomposer/src/capcomposer/capeditor/blocks.py:729
msgid "Parameter"
msgstr "Parâmetro"

#: capcomposer/src/capcomposer/capeditor/blocks.py:729
msgid "Parameters"
msgstr "Parâmetros"

#: capcomposer/src/capcomposer/capeditor/blocks.py:749
msgid "The expiry time of the alert should be greater than the effective time"
msgstr "O tempo de expiração do alerta deve ser maior que o tempo efetivo"

#: capcomposer/src/capcomposer/capeditor/blocks.py:754
msgid "The expiry time of the alert should be greater than the onset time"
msgstr "O tempo de expiração do alerta deve ser maior que o tempo de início"

#: capcomposer/src/capcomposer/capeditor/blocks.py:779
msgid ""
"Alert area polygons must not overlap each other. CAP does not allow "
"intersecting areas."
msgstr ""
"Os polígonos da área de alerta não devem se sobrepor. O CAP não permite "
"áreas de interseção."

#: capcomposer/src/capcomposer/capeditor/blocks.py:787
msgid "Contact Detail"
msgstr "Detalhes de contato"

#: capcomposer/src/capcomposer/capeditor/cap_settings.py:29
msgid "CAP Sender Email"
msgstr "E-mail do remetente CAP"

#: capcomposer/src/capcomposer/capeditor/cap_settings.py:30
msgid "Email of the sending institution"
msgstr "E-mail da instituição remetente"

#: capcomposer/src/capcomposer/capeditor/cap_settings.py:31
