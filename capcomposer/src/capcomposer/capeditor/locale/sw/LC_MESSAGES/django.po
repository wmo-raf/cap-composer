msgstr "Msimbo unaoashiria asili ya ujumbe wa arifa"

#: capcomposer/src/capcomposer/capeditor/models.py:204
msgid "Scope"
msgstr "Upeo"

#: capcomposer/src/capcomposer/capeditor/models.py:205
msgid "The code denoting the intended distribution of the alert message"
msgstr "Msimbo unaoashiria usambazaji unaokusudiwa wa ujumbe wa tahadhari"

#: capcomposer/src/capcomposer/capeditor/models.py:206
msgid "Source"
msgstr "Chanzo"

#: capcomposer/src/capcomposer/capeditor/models.py:207
msgid "The text identifying the source of the alert message"
msgstr "Maandishi yanayotambulisha chanzo cha ujumbe wa arifa"

#: capcomposer/src/capcomposer/capeditor/models.py:209
msgid ""
"The text describing the rule for limiting distribution of the restricted "
"alert message. Used when scope value is Restricted"
msgstr ""
"Maandishi yanayoelezea sheria ya kuzuia usambazaji wa ujumbe wa tahadhari "
"uliowekewa vikwazo. Inatumika wakati thamani ya upeo imezuiwa"

#: capcomposer/src/capcomposer/capeditor/models.py:211
msgid "Restriction"
msgstr "Kizuizi"

#: capcomposer/src/capcomposer/capeditor/models.py:213
msgid "The code denoting the special handling of the alert message"
msgstr "Msimbo unaoashiria utunzaji maalum wa ujumbe wa tahadhari"

#: capcomposer/src/capcomposer/capeditor/models.py:214
msgid "Code"
msgstr "Kanuni"

#: capcomposer/src/capcomposer/capeditor/models.py:216
msgid ""
"The text describing the purpose or significance of the alert message.The "
"message note is primarily intended for use with <status> 'Exercise' and "
"<msgType> 'Error'"
msgstr ""
"Maandishi yanayoelezea madhumuni au umuhimu wa ujumbe wa tahadhari. Ujumbe "
"huu unakusudiwa kutumiwa na <status> 'Zoezi' na <msgType> 'Error'."

